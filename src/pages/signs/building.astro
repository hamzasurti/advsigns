---
import Layout from "../../layouts/Layout.astro";
import Building, { meta, structuredData } from "../../views/signs/Building";
import { photoSources } from "../../lib/photos";
import { workFor } from "../../components/SignParts";

const photos = await photoSources(workFor("Building Signs").map((p) => p.image));
---

<Layout meta={meta} structuredData={structuredData}>
  <Building client:idle photos={photos} />
</Layout>
