---
import Layout from "../../layouts/Layout.astro";
import Lobby, { meta } from "../../views/signs/Lobby";
import { photoSources } from "../../lib/photos";
import { workFor } from "../../components/SignParts";

const photos = await photoSources(workFor("Lobby Signs").map((p) => p.image));
---

<Layout meta={meta}>
  <Lobby client:idle photos={photos} />
</Layout>
